# Demo local: ejecutar desde client con un único proceso Node.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_PATH=admin-secret
# El servidor decide sesión y almacenamiento; nunca poner secretos en NEXT_PUBLIC_*.
SOKY_DEMO_MODE=on
# Opcional para pruebas aisladas, solo nombre simple; omitir para .soky-demo/state.json.
