# Demo: solo el valor exacto on permite edición. Mantener off durante preparación.
SOKY_DEMO_MODE=off
SOKY_DEMO_STORAGE=redis
SOKY_DEMO_NAMESPACE=default
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_PATH=admin-secret

# Credenciales solo de servidor, en .env.local ignorado por Git.
# Mapeo de la integración Vercel con Custom Prefix=STORAGE:
# STORAGE_KV_REST_API_URL=https://example.upstash.io
# STORAGE_KV_REST_API_TOKEN=replace-locally
# También se admite la pareja canónica UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
# No usar el token READ_ONLY para la demo editable.

# Compatibilidad local de un proceso (prohibida en Vercel):
# SOKY_DEMO_STORAGE=file
# SOKY_DEMO_MODE=on
# SOKY_DEMO_DATA_FOLDER=qa-local
