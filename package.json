{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node tests/support/run-playwright.mjs",
    "test:api": "node tests/support/run-playwright.mjs --project=api-on --project=api-off",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "motion": "^12.43.0",
    "next": "16.4.3",
    "next-transition-router": "^0.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
